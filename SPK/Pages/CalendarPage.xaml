<Page x:Class="SistemPengurusanKehadiran.Pages.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Light" Background="#F8FAFD" UseLayoutRounding="True">
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="14"><Border Width="58" Height="58" CornerRadius="17" Background="{StaticResource MintBrush}"><FontIcon Glyph="&#xE787;" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Takwim" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Panduan hari persekolahan, cuti dan minggu akademik" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="Tahun" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/><NumberBox x:Name="YearFilter" Width="105" Minimum="2020" Maximum="2100" ValueChanged="YearFilter_ValueChanged"/><Border Background="#ECF8F4" CornerRadius="14" Padding="14,8"><TextBlock x:Name="CountText" Text="0 HARI" Foreground="{StaticResource MintBrush}" FontWeight="Bold"/></Border></StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}"><ScrollViewer><StackPanel Spacing="10"><TextBlock Text="Rekod Takwim" Style="{StaticResource SectionTitleStyle}"/><CalendarDatePicker x:Name="Tarikh" Header="Tarikh"/><ComboBox x:Name="Jenis" Header="Jenis" SelectedIndex="0"><ComboBoxItem Content="Hari Persekolahan"/><ComboBoxItem Content="Cuti Penggal"/><ComboBoxItem Content="Cuti Umum"/><ComboBoxItem Content="Cuti Perayaan"/><ComboBoxItem Content="Cuti Hujung Minggu"/></ComboBox><TextBox x:Name="Tajuk" Header="Tajuk"/><ToggleSwitch x:Name="Hari" Header="Hari Persekolahan" IsOn="True"/><NumberBox x:Name="Minggu" Header="Minggu Akademik" Minimum="1" Maximum="60"/><TextBox x:Name="Catatan" Header="Catatan" AcceptsReturn="True" Height="86" TextWrapping="Wrap"/><Button Content="Simpan / Kemas Kini" Style="{StaticResource SuccessButtonStyle}" Click="Save_Click"/><TextBlock x:Name="FormStatus" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></ScrollViewer></Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid Background="#F2F6FC" Padding="16,11"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="TARIKH" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="JENIS" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="2" Text="TAJUK" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="3" Text="SEKOLAH" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/></Grid><ListView x:Name="List" Grid.Row="1" SelectionChanged="List_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="12,9"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Tarikh}"/><TextBlock Grid.Column="1" Text="{Binding Jenis}"/><TextBlock Grid.Column="2" Text="{Binding Tajuk}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding HariLabel}" FontWeight="SemiBold"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
        </Grid>
    </Grid>
</Page>
