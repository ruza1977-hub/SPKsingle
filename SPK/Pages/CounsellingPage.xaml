<Page x:Class="SistemPengurusanKehadiran.Pages.CounsellingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F8FAFD" RequestedTheme="Light" UseLayoutRounding="True"><Grid Padding="28" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal" Spacing="14"><Border Width="58" Height="58" CornerRadius="17" Background="{StaticResource PurpleBrush}"><FontIcon Glyph="&#xE8BD;" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Kaunseling" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Rekod sesi, rumusan dan tindakan susulan murid" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel><Border HorizontalAlignment="Right" Background="#F0ECFF" CornerRadius="14" Padding="15,8"><TextBlock x:Name="CountText" Text="0 SESI" Foreground="{StaticResource PurpleBrush}" FontWeight="Bold"/></Border></Grid><Grid Grid.Row="1" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="600"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardBorderStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="11"><TextBlock x:Name="FormTitle" Text="Sesi Baharu" Style="{StaticResource SectionTitleStyle}"/><ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="StudentPicker" Header="Murid" DisplayMemberPath="Display" PlaceholderText="Pilih murid"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><DatePicker Style="{StaticResource CaseDatePickerStyle}" x:Name="SessionDate" Header="Tarikh Sesi"/><ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="SessionType" Grid.Column="1" Header="Jenis Sesi"/></Grid><ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="TeacherPicker" Header="Guru / Kaunselor" DisplayMemberPath="Nama" PlaceholderText="Pilih guru"/><TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Summary" Header="Rumusan Sesi" AcceptsReturn="True" TextWrapping="Wrap" Height="122"/><TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="NextAction" Header="Tindakan Seterusnya" AcceptsReturn="True" TextWrapping="Wrap" Height="92"/><TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Notes" Header="Catatan" AcceptsReturn="True" TextWrapping="Wrap" Height="76"/><StackPanel Orientation="Horizontal" Spacing="9"><Button Content="＋ Tambah Baru" Click="New_Click"/><Button Content="Simpan" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/><Button Content="Padam" Style="{StaticResource DangerButtonStyle}" Click="Delete_Click"/></StackPanel><TextBlock x:Name="FormStatus" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></ScrollViewer></Border><StackPanel Grid.Column="1" Spacing="12"><TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Search" PlaceholderText="Cari murid, kelas, jenis atau rumusan" TextChanged="Search_TextChanged"/><Border Style="{StaticResource CardBorderStyle}" Padding="0"><ListView x:Name="List" SelectionChanged="List_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="14,11" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StudentName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Kelas}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding SessionType}" FontWeight="SemiBold"/><TextBlock Text="{Binding TeacherDisplay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding DateText}" VerticalAlignment=