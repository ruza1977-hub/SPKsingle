<Page x:Class="SistemPengurusanKehadiran.Pages.StudentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Light" Background="#F8FAFD" UseLayoutRounding="True">
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="58" Height="58" CornerRadius="17" Background="{StaticResource BlueBrush}">
                    <FontIcon Glyph="&#xE716;" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Murid" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Profil murid dan maklumat penjaga" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="#EAF2FE" CornerRadius="14" Padding="15,8">
                <TextBlock x:Name="CountText" Text="0 MURID" Foreground="{StaticResource BlueBrush}" FontWeight="Bold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Rekod Murid" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBox x:Name="NoMurid" Header="No. Murid / No. KP"/>
                        <TextBox x:Name="Nama" Header="Nama Murid"/>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="Kelas" Header="Kelas"/><TextBox x:Name="Tingkatan" Grid.Column="1" Header="Tingkatan / Tahun"/></Grid>
                        <TextBox x:Name="Penjaga" Header="Nama Penjaga"/>
                        <TextBox x:Name="Telefon" Header="Telefon"/>
                        <TextBox x:Name="Alamat" Header="Alamat" AcceptsReturn="True" Height="86" TextWrapping="Wrap"/>
                        <ToggleSwitch x:Name="Aktif" Header="Status" OnContent="Aktif" OffContent="Tidak Aktif" IsOn="True"/>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Button Content="＋ Baharu" Click="New_Click"/>
                            <Button Content="Simpan" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
                            <Button Content="Padam" Style="{StaticResource DangerButtonStyle}" Click="Delete_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="FormStatus" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
                <TextBox x:Name="Search" PlaceholderText="Cari nama / kelas / No. Murid" TextChanged="Search_TextChanged"/>
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid Background="#F2F6FC" Padding="16,11" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <TextBlock Text="NAMA / NO. MURID" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="KELAS" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="PENJAGA" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                        <ListView x:Name="List" Grid.Row="1" SelectionChanged="List_SelectionChanged">
                            <ListView.ItemTemplate><DataTemplate><Grid Padding="12,9" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Nama}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding NoMurid}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Kelas}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Penjaga}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
