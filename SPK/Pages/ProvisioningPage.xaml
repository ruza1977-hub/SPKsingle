<Page x:Class="SistemPengurusanKehadiran.Pages.ProvisioningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Light" Background="#F8FAFD">
    <Grid>
        <ScrollViewer>
            <Grid Padding="48" MaxWidth="820" HorizontalAlignment="Center">
                <StackPanel Spacing="22">
                    <Border Width="82" Height="82" CornerRadius="24" Background="#DFF7F1" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="38" Foreground="#159A7D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Aktifkan SPK Windows" FontSize="32" FontWeight="Bold" Foreground="#173D68" HorizontalAlignment="Center"/>
                        <TextBlock Text="Masukkan kod pengaktifan sekali sahaja. Kod ini mengikat PC kepada ID Guru dan sekolah. Selepas berjaya, aplikasi akan terus bersambung secara automatik."
                                   FontSize="15" Foreground="#657386" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="650"/>
                    </StackPanel>
                    <Border Background="White" CornerRadius="22" Padding="28" BorderBrush="#16000000" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Kod Pengaktifan" FontWeight="SemiBold" FontSize="16" Foreground="#173D68"/>
                            <TextBox x:Name="ActivationCodeBox" PlaceholderText="Contoh: ABCD-1234" FontSize="22" CharacterCasing="Upper"
                                     HorizontalContentAlignment="Center" TextChanged="ActivationCodeBox_TextChanged"/>
                            <TextBlock x:Name="DeviceText" Foreground="#657386" TextWrapping="Wrap"/>
                            <Button x:Name="ActivateButton" Content="Aktifkan PC Ini" Height="48" CornerRadius="12"
                                    Background="#159A7D" Foreground="White" FontWeight="SemiBold" Click="ActivateButton_Click" IsEnabled="False"/>
                            <ProgressRing x:Name="Busy" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center"/>
                            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Credential peranti disimpan secara terlindung menggunakan Windows DPAPI. Kod pengaktifan tidak disimpan selepas berjaya."
                               Foreground="#7B8794" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
