<Page x:Class="SistemPengurusanKehadiran.Pages.TeachersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Light" Background="#F8FAFD" UseLayoutRounding="True">
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="14"><Border Width="58" Height="58" CornerRadius="17" Background="{StaticResource PurpleBrush}"><FontIcon Glyph="&#xE77B;" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Guru" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Senarai guru yang digunakan oleh modul kes dan intervensi" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel>
            <Border HorizontalAlignment="Right" Background="#F0ECFB" CornerRadius="14" Padding="15,8"><TextBlock x:Name="CountText" Text="0 GURU" Foreground="{StaticResource PurpleBrush}" FontWeight="Bold"/></Border>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="11"><TextBlock Text="Rekod Guru" Style="{StaticResource SectionTitleStyle}"/><TextBox x:Name="Nama" Header="Nama Guru"/><TextBox x:Name="Jawatan" Header="Jawatan" Text="Guru"/><TextBox x:Name="Telefon" Header="Telefon"/><ToggleSwitch x:Name="Aktif" Header="Status" IsOn="True" OnContent="Aktif" OffContent="Tidak Aktif"/><StackPanel Orientation="Horizontal" Spacing="9"><Button Content="＋ Baharu" Click="New_Click"/><Button Content="Simpan" Style="{StaticResource PurpleButtonStyle}" Click="Save_Click"/><Button Content="Padam" Style="{StaticResource DangerButtonStyle}" Click="Delete_Click"/></StackPanel><TextBlock x:Name="FormStatus" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
            <StackPanel Grid.Column="1" Spacing="12"><TextBox x:Name="Search" PlaceholderText="Cari nama / jawatan / telefon" TextChanged="Search_TextChanged"/><Border Style="{StaticResource CardBorderStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid Background="#F2F6FC" Padding="16,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="NAMA GURU" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="JAWATAN" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="2" Text="TELEFON" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/></Grid><ListView x:Name="List" Grid.Row="1" SelectionChanged="List_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Nama}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Jawatan}"/><TextBlock Grid.Column="2" Text="{Binding Telefon}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border></StackPanel>
        </Grid>
    </Grid>
</Page>
