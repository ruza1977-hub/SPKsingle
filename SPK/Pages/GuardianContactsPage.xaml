<Page x:Class="SistemPengurusanKehadiran.Pages.GuardianContactsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F8FAFD" RequestedTheme="Light" UseLayoutRounding="True">
<Grid Padding="28" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<Grid><StackPanel Orientation="Horizontal" Spacing="14"><Border Width="58" Height="58" CornerRadius="17" Background="{StaticResource BlueBrush}"><FontIcon Glyph="&#xE717;" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Hubungan Penjaga" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Rekod panggilan, WhatsApp, SMS, surat dan pertemuan penjaga" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel><Border HorizontalAlignment="Right" Background="#EAF2FE" CornerRadius="14" Padding="15,8"><TextBlock x:Name="CountText" Text="0 REKOD" Foreground="{StaticResource BlueBrush}" FontWeight="Bold"/></Border></Grid>
<Grid Grid.Row="1" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="600"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource CardBorderStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="11"><TextBlock x:Name="FormTitle" Text="Rekod Hubungan Baharu" Style="{StaticResource SectionTitleStyle}"/><ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="StudentPicker" Header="Murid" DisplayMemberPath="Display" PlaceholderText="Pilih murid" SelectionChanged="StudentPicker_SelectionChanged"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><DatePicker Style="{StaticResource CaseDatePickerStyle}" x:Name="ContactDate" Header="Tarikh"/><ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="Method" Grid.Column="1" Header="Kaedah"/></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="GuardianName" Header="Nama Penjaga"/><TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Phone" Grid.Column="1" Header="Telefon"/></Grid><TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Outcome" Header="Hasil / Respons Penjaga" AcceptsReturn="True" TextWrapping="Wrap" Height="115"/><TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Notes" Header="Catatan" AcceptsReturn="True" TextWrapping="Wrap" Height="88"/><StackPanel Orientation="Horizontal" Spacing="9"><Button Content="＋ Tambah Baru" Click="New_Click"/><Button Content="Simpan" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/><Button Content="Padam" Style="{StaticResource DangerButtonStyle}" Click="Delete_Click"/></StackPanel><TextBlock x:Name="FormStatus" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
<StackPanel Grid.Column="1" Spacing="12"><TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Search" PlaceholderText="Cari murid, penjaga atau kaedah" TextChanged="Search_TextChanged"/><Border Style="{StaticResource CardBorderStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid Background="#F2F6FC" Padding="16,11" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="MURID" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="KAEDAH" FontWeight="Bold"/><TextBlock Grid.Column="2" Text="PENJAGA" FontWeight="Bold"/></Grid><ListView x:Name="List" Grid.Row="1" SelectionChanged="List_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="12,10" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StudentName}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Kelas}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="•"/><TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="{Binding Method}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding GuardianName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border></StackPanel>
</Grid></Grid></Page>
