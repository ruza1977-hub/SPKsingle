<Page x:Class="SistemPengurusanKehadiran.Pages.InterventionsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F8FAFD" RequestedTheme="Light" UseLayoutRounding="True"><Grid Padding="28" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal" Spacing="14"><Border Width="58" Height="58" CornerRadius="17" Background="{StaticResource AmberBrush}"><FontIcon Glyph="&#xE90F;" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Intervensi" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Rancang tindakan, sasaran, guru bertanggungjawab dan hasil intervensi" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel><Border HorizontalAlignment="Right" Background="#FFF6E6" CornerRadius="14" Padding="15,8"><TextBlock x:Name="CountText" Text="0 INTERVENSI" Foreground="{StaticResource AmberBrush}" FontWeight="Bold"/></Border></Grid><Grid Grid.Row="1" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="600"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardBorderStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="11"><TextBlock x:Name="FormTitle" Text="Intervensi Baharu" Style="{StaticResource SectionTitleStyle}"/><ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="StudentPicker" Header="Murid" DisplayMemberPath="Display" PlaceholderText="Pilih murid"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><DatePicker Style="{StaticResource CaseDatePickerStyle}" x:Name="InterventionDate" Header="Tarikh Intervensi"/><ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="InterventionType" Grid.Column="1" Header="Jenis"/></Grid