<Page x:Class="SistemPengurusanKehadiran.Pages.CaseProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F8FAFD" RequestedTheme="Light" UseLayoutRounding="True">
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="58" Height="58" CornerRadius="17" Background="{StaticResource CoralBrush}"><FontIcon Glyph="&#xE8B7;" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Profil Kes" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Buka dan urus fail kes murid • semua tindakan berkait melalui murid" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="#FFF0F1" CornerRadius="14" Padding="15,8"><TextBlock x:Name="CountText" Text="0 KES" Foreground="{StaticResource CoralBrush}" FontWeight="Bold"/></Border>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="600"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="11">
                    <TextBlock x:Name="FormTitle" Text="Buka Kes Baharu" Style="{StaticResource SectionTitleStyle}"/>
                    <ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="StudentPicker" Header="Murid" DisplayMemberPath="Display" PlaceholderText="Pilih murid"/>
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><DatePicker Style="{StaticResource CaseDatePickerStyle}" x:Name="OpenedAt" Header="Tarikh Buka"/><ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="Status" Grid.Column="1" Header="Status"/></Grid>
                    <ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="Category" Header="Kategori Kes"/>
                    <ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="TeacherPicker" Header="Guru Bertanggungjawab" DisplayMemberPath="Nama" PlaceholderText="Pilih guru"/>
                    <TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Summary" Header="Ringkasan Kes" AcceptsReturn="True" TextWrapping="Wrap" Height="110"/>
                    <TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Notes" Header="Catatan" AcceptsReturn="True" TextWrapping="Wrap" Height="88"/>
                    <StackPanel Orientation="Horizontal" Spacing="9"><Button Content="＋ Tambah Baru" Click="New_Click"/><Button Content="Simpan" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/><Button Content="Padam" Style="{StaticResource DangerButtonStyle}" Click="Delete_Click"/></StackPanel>
                    <TextBlock x:Name="FormStatus" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
            </Border>
            <StackPanel Grid.Column="1" Spacing="12">
                <TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Search" PlaceholderText="Cari murid, kelas, kategori atau status" TextChanged="Search_TextChanged"/>
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid Background="#F2F6FC" Padding="16,11" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions><TextBlock Text="MURID / KELAS" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="KATEGORI" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="2" Text="STATUS" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/></Grid>
                        <ListView x:Name="List" Grid.Row="1" SelectionChanged="List_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="12,10" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Kelas}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="•"/><TextBlock Text="{Binding DateText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="{Binding Category}" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
