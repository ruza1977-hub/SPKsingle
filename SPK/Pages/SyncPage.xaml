<Page
    x:Class="SistemPengurusanKehadiran.Pages.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="#F8FAFD"
    UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28" Spacing="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Sync Railway" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="SQLite local ↔ FastAPI / PostgreSQL · incremental dua hala · tenant sekolah terkunci"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#EAF7F2" CornerRadius="14" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border x:Name="ConnectionDot" Width="8" Height="8" CornerRadius="4"
                                Background="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionBadge" Text="Belum diuji" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#466159"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="SERVER" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="ServerText" Text="Server Config belum diimport"
                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource NavyBrush}"/>
                        <TextBlock x:Name="SchoolGuardText" Text="School ID belum tersedia"
                                   FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="QUEUE LOKAL" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="PendingText" Text="0" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource AmberBrush}"/>
                        <TextBlock Text="belum dihantar" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="KONFLIK" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="ConflictText" Text="0" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource CoralBrush}"/>
                        <TextBlock Text="perlu semakan" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="REVISION" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="RevisionText" Text="0" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource MintBrush}"/>
                        <TextBlock Text="pull terakhir" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Kawalan Sync" Style="{StaticResource SectionTitleStyle}"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Import / Tukar Server Config" Style="{StaticResource PrimaryButtonStyle}" Click="ImportConfig_Click"/>
                            <Button Content="Uji Server" Padding="16,10" CornerRadius="10" Click="Test_Click"/>
                            <Button Content="Sync Sekarang" Style="{StaticResource SuccessButtonStyle}" Click="Sync_Click"/>
                            <Button Content="Segar" Padding="16,10" CornerRadius="10" Click="Refresh_Click"/>
                            <ProgressRing x:Name="SyncSpinner" Width="26" Height="26" IsActive="False"
                                          VerticalAlignment="Center"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#16000000" Margin="0,2"/>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Auto Sync" FontWeight="SemiBold"/>
                                <TextBlock Text="Server Config hanya perlu dipasang sekali. Selepas tersedia, sync boleh berjalan terus dan Auto Sync akan digunakan mengikut tetapan peranti."
                                           FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoSyncToggle" Grid.Column="1" HorizontalAlignment="Right"
                                          OnContent="Aktif" OffContent="Tidak aktif" Toggled="AutoSync_Toggled"/>
                        </Grid>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Selang Auto Sync" FontWeight="SemiBold"/>
                                <TextBlock Text="Tetapan lokal peranti; tidak disalin ke server."
                                           FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                            <ComboBox x:Name="IntervalCombo" Grid.Column="1" Width="180"
                                      HorizontalAlignment="Right" SelectionChanged="Interval_SelectionChanged">
                                <ComboBoxItem Content="5 minit" Tag="5"/>
                                <ComboBoxItem Content="15 minit" Tag="15"/>
                                <ComboBoxItem Content="30 minit" Tag="30"/>
                                <ComboBoxItem Content="60 minit" Tag="60"/>
                            </ComboBox>
                        </Grid>

                        <Rectangle Height="1" Fill="#16000000" Margin="0,2"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sync terakhir" Foreground="#64748B"/>
                            <TextBlock x:Name="LastSyncText" Grid.Column="1" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Peranti" Foreground="#64748B"/>
                            <TextBlock x:Name="DeviceText" Grid.Column="1" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Queue Mengikut Modul" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Rekod pending akan dihantar secara incremental."
                                   FontSize="12" Foreground="#64748B"/>
                        <ListView x:Name="QueueList" Height="280" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"/>
                                        <Border Grid.Column="1" Background="#FFF4DD" CornerRadius="10"
                                                Padding="8,3" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Count}" FontWeight="SemiBold"
                                                       Foreground="#A56500"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Status &amp; Konflik" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock x:Name="AutoStatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#64748B" FontSize="12"/>
                    </Grid>

                    <Border Background="#F5F8FC" BorderBrush="#16000000" BorderThickness="1"
                            CornerRadius="10" Padding="12">
                        <TextBlock x:Name="Status" Text="Sedia" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ListView x:Name="ConflictList" MaxHeight="230" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RecordId}" FontFamily="Consolas"
                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Reason}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CreatedText}" Foreground="#64748B"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="Konflik tidak akan menimpa rekod lokal pending. Rekod konflik kekal untuk semakan sebelum keputusan dibuat."
                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
