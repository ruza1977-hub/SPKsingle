<Page x:Class="SistemPengurusanKehadiran.Pages.WarningLettersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFD" RequestedTheme="Light" UseLayoutRounding="True">
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="58" Height="58" CornerRadius="17" Background="{StaticResource CoralBrush}"><FontIcon Glyph="&#xE8A5;" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Surat Amaran" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Jana, simpan, pratonton dan eksport PDF daripada SQLite" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="#FFF0F1" CornerRadius="14" Padding="15,8"><TextBlock x:Name="CountText" Text="0 SURAT" Foreground="{StaticResource CoralBrush}" FontWeight="Bold"/></Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="560"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="11">
                    <TextBlock x:Name="FormTitle" Text="Surat Amaran Baharu" Style="{StaticResource SectionTitleStyle}"/>
                    <ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="StudentPicker" Header="Murid" DisplayMemberPath="Display" PlaceholderText="Pilih murid" SelectionChanged="StudentPicker_SelectionChanged"/>
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <DatePicker Style="{StaticResource CaseDatePickerStyle}" x:Name="IssueDate" Header="Tarikh Surat" DateChanged="IssueDate_DateChanged"/>
                        <ComboBox Style="{StaticResource CaseComboBoxStyle}" x:Name="WarningType" Grid.Column="1" Header="Jenis Surat" SelectionChanged="WarningType_SelectionChanged"/>
                    </Grid>
                    <TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="ReferenceNo" Header="No. Rujukan (pilihan)" PlaceholderText="Contoh: SPK/HEM/2026/001"/>
                    <TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="GuardianName" Header="Nama Penjaga"/>
                    <TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="GuardianAddress" Header="Alamat Penjaga" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="AbsenceCount" Header="Jumlah Ketidakhadiran" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Set Semula Templat" Click="ResetTemplate_Click" VerticalAlignment="Bottom" Height="38"/>
                    </Grid>
                    <TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="LetterTitle" Header="Tajuk Surat"/>
                    <TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="LetterBody" Header="Kandungan Surat" AcceptsReturn="True" TextWrapping="Wrap" Height="190"/>
                    <TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Notes" Header="Catatan" AcceptsReturn="True" TextWrapping="Wrap" Height="75"/>
                    <!-- Windows App SDK 1.8-safe layout. WrapPanel is avoided here because
                         some 1.8 toolchains/XAML designers do not resolve it reliably. -->
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="＋ Baharu" Click="New_Click"/>
                            <Button Content="Jana &amp; Simpan PDF" Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click"/>
                            <Button Content="Eksport PDF" Click="Export_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Buka / Cetak" Click="OpenPrint_Click"/>
                            <Button Content="Padam" Style="{StaticResource DangerButtonStyle}" Click="Delete_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="FormStatus" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="285"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <StackPanel Padding="16,14" Spacing="10"><TextBlock Text="Surat Dalam Database" Style="{StaticResource SectionTitleStyle}"/><TextBox Style="{StaticResource CaseTextBoxStyle}" x:Name="Search" PlaceholderText="Cari nama murid, kelas, jenis surat atau rujukan" TextChanged="Search_TextChanged"/></StackPanel>
                        <ListView x:Name="List" Grid.Row="1" SelectionChanged="List_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="12,9" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding Kelas}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding WarningType}" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding DateText}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid><WebView2 x:Name="PdfPreview"/><StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><FontIcon Glyph="&#xE8A5;" FontSize="45" Foreground="{StaticResource CoralBrush}"/><TextBlock Text="Pratonton PDF" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/><TextBlock Text="Jana atau pilih surat yang sudah disimpan." Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
