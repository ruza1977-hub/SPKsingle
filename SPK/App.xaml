<Application
    x:Class="SistemPengurusanKehadiran.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="NavigationViewExpandedPaneBackground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14365F" Offset="0"/>
                <GradientStop Color="#1C5682" Offset="1"/>
            </LinearGradientBrush>

            <!-- Define brushes directly to avoid XAML designer warnings for <Color> resources. -->
            <SolidColorBrush x:Key="NavyBrush" Color="#14365F"/>
            <SolidColorBrush x:Key="BlueBrush" Color="#2F80ED"/>
            <SolidColorBrush x:Key="MintBrush" Color="#2DBE9B"/>
            <SolidColorBrush x:Key="CoralBrush" Color="#F35D65"/>
            <SolidColorBrush x:Key="AmberBrush" Color="#F5A623"/>
            <SolidColorBrush x:Key="PurpleBrush" Color="#7656D8"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#465365"/>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFFFF"/>
                <Setter Property="BorderBrush" Value="#26000000"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="18"/>
            </Style>
            <Style x:Key="SoftCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Background" Value="#FBFCFE"/>
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource MintBrush}"/>
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource CoralBrush}"/>
            </Style>
            <Style x:Key="PurpleButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
            </Style>


            <!-- Global Light UI controls: prevents Windows Dark Mode from making
                 form fields appear white/invisible on the app's light background. -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#B8C4D4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#B8C4D4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>
            <Style TargetType="CalendarDatePicker">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#B8C4D4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#B8C4D4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>
            <Style TargetType="NumberBox">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#B8C4D4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>
            <Style TargetType="ToggleSwitch">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <Style x:Key="CaseTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#C7D1DE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>
            <Style x:Key="CaseComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#C7D1DE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>
            <Style x:Key="CaseDatePickerStyle" TargetType="DatePicker">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="#C7D1DE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
